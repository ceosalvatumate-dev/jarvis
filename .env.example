# Jarvis — Academia Salva Tomate (Claude Code local, suscripción). Copia a .env y chmod 600.
# NUNCA subas .env a git (está en .gitignore). bin/instalar.sh lo crea por ti.
#
# SIN llave del modelo a propósito: Claude Code usa tu propio /login de Claude Pro/Max.
# ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN y CLAUDE_CODE_OAUTH_TOKEN deben quedar SIN definir:
# cambiarían el cobro a la API y apagarían Remote Control.
#
# El token del bot de Telegram NO va aquí: vive en ~/.claude/channels/telegram/.env (modo 600),
# lo escribes tú en un editor. jobs/run-job.sh lo lee de ahí en un subshell.

# Zona horaria de los trabajos programados (nombre IANA).
JARVIS_TZ=America/Mexico_City
# Nombre de la sesión de tmux que usa bin/jarvis-up.sh.
JARVIS_TMUX_SESSION=jarvis
# Reinicia la sesión cuando Claude Code pase de esta memoria en KB (3 GB).
JARVIS_RSS_CAP_KB=3145728
# Tu ID numérico de Telegram (no es secreto): a donde llegan los reportes. Pídeselo a @userinfobot.
OWNER_TELEGRAM_ID=
# Alias de modelo para los trabajos programados (alias, nunca IDs completos).
JARVIS_MODEL_CHEAP=haiku
JARVIS_MODEL_MAIN=sonnet
# Límites por corrida de los trabajos programados.
JARVIS_MAX_TURNS=12
JARVIS_MAX_BUDGET_USD=0.50
# Tope diario del piloto automático (USD estimados).
JARVIS_AUTOPILOT_DAILY_USD=1.00
# Canales de los que aprende (solo los tuyos).
JARVIS_LEARN_CHANNELS=telegram
# Medios: modelo local de voz a texto; nube apagada.
JARVIS_WHISPER_MODEL=models/ggml-large-v3-turbo-q5_0.bin
JARVIS_STT_CLOUD=off
JARVIS_STT_CLOUD_MODEL=
JARVIS_SENSITIVE_PACK=0

# --- Meta (solo lectura). Los lee SOLO bin/meta-sync.py; Claude nunca los ve. ---
# Token de un "usuario del sistema" de Meta Business (RUNBOOK.md § Meta, paso a paso).
META_ACCESS_TOKEN=
# ID numérico de tu página de Facebook.
META_PAGE_ID=
# ID numérico de tu cuenta profesional de Instagram (vinculada a la página).
META_IG_USER_ID=
# ID de tu cuenta publicitaria (con o sin "act_").
META_AD_ACCOUNT_ID=
# Versión de la Graph API (vigente: v26.0, julio 2026).
META_GRAPH_VERSION=v26.0
# Opcional: secreto de tu app de Meta para firmar las llamadas (appsecret_proof).
META_APP_SECRET=
